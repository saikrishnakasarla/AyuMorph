# AyuMorph Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.

SECRET_KEY=django-insecure-ayumorph-btech-finalyear-project-key-2026-safe-dev
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Machine Learning Model Configuration
# Path relative to project root or absolute path
MODEL_PATH=classifier/ml_model/model.h5

# Model Input Specifications
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224

# Binary Classification Threshold (0.0 to 1.0)
MODEL_THRESHOLD=0.5

# Class index mapping for binary model:
# If model outputs sigmoid score > 0.5:
# CLASS_ABOVE_THRESHOLD=Non-Ayurvedic Plant (or Ayurvedic Plant depending on your training generator)
# Default is standard alphabetical order: 0 = Ayurvedic Plant, 1 = Non-Ayurvedic Plant
CLASS_0_NAME=Ayurvedic Plant
CLASS_1_NAME=Non-Ayurvedic Plant
